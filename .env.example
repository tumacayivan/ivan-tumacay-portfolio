# Telegram notification backend — copy to .env for local dev, and set the
# same variables in your Render service's Environment settings for production.
# NEVER commit the real values. .env is gitignored.

# Token from BotFather. Treat as a password.
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Destination channel/chat. The bot MUST be an admin of this channel.
TELEGRAM_CHANNEL=@tumacayivan

# Port is provided automatically by Render in production. For local dev the
# server defaults to 3001 (matched by the Vite proxy in vite.config.ts).
# PORT=3001
