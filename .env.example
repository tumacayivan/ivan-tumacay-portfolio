# Telegram notification backend — copy to .env for local dev, and set the
# same variables in your Render service's Environment settings for production.
# NEVER commit the real values. .env is gitignored.

# Token from BotFather. Treat as a password.
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Destination channel/chat. The bot MUST be an admin of this channel.
TELEGRAM_CHANNEL=@tumacayivan

# Port is provided automatically by Render in production. For local dev the
# server defaults to 3001 (matched by the Vite proxy in vite.config.ts).
# PORT=3001

# --- Option B only: static site + separate backend Web Service ---
# On the BACKEND service, restrict which site origin may call it (optional but
# recommended). Comma-separated. Defaults to "*" (any origin) if unset.
# ALLOWED_ORIGIN=https://your-portfolio.onrender.com
#
# On the STATIC SITE build, point the frontend at the backend service URL.
# This is a Vite build-time var (must start with VITE_). Set it in the Static
# Site's Environment settings, then redeploy so it gets baked into the bundle.
# VITE_API_BASE=https://your-backend.onrender.com
