@import url('https://fonts.googleapis.com/css2?family=Special+Elite&family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=Cutive+Mono&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    /* PURE DECLASSIFIED DOCUMENT - BLACK INK ON AGED PAPER */
    --background: 42 28% 90%;          /* aged photocopy paper */
    --foreground: 0 0% 8%;             /* black ink */

    --card: 38 26% 84%;
    --card-foreground: 0 0% 8%;

    --popover: 38 26% 84%;
    --popover-foreground: 0 0% 8%;

    --primary: 0 0% 8%;                /* black */
    --primary-foreground: 42 28% 90%;

    --secondary: 36 14% 75%;
    --secondary-foreground: 0 0% 8%;

    --muted: 38 16% 82%;
    --muted-foreground: 0 0% 28%;

    --accent: 0 0% 8%;
    --accent-foreground: 42 28% 90%;

    --destructive: 0 0% 8%;
    --destructive-foreground: 42 28% 90%;

    --border: 0 0% 12%;
    --input: 0 0% 12%;
    --ring: 0 0% 8%;

    --radius: 0rem;

    --sidebar-background: 38 26% 84%;
    --sidebar-foreground: 0 0% 8%;
    --sidebar-primary: 0 0% 8%;
    --sidebar-primary-foreground: 42 28% 90%;
    --sidebar-accent: 36 14% 75%;
    --sidebar-accent-foreground: 0 0% 8%;
    --sidebar-border: 0 0% 12%;
    --sidebar-ring: 0 0% 8%;

    --gold-glow: 0 0% 8%;
    --surface-hover: 38 22% 80%;

    /* Single ink colour. Aliases retained for compatibility. */
    --paper: 42 28% 90%;
    --paper-cream: 38 26% 86%;
    --paper-beige: 38 24% 82%;
    --paper-gray: 36 14% 75%;
    --ink-charcoal: 0 0% 8%;
    --ink-brown: 0 0% 20%;
    --stamp-red: 0 0% 8%;
    --stamp-blue: 0 0% 8%;
  }

  .dark {
    --background: 0 0% 12%;
    --foreground: 42 28% 88%;

    --card: 0 0% 16%;
    --card-foreground: 42 28% 88%;

    --popover: 0 0% 16%;
    --popover-foreground: 42 28% 88%;

    --primary: 42 28% 88%;
    --primary-foreground: 0 0% 12%;

    --secondary: 0 0% 20%;
    --secondary-foreground: 42 28% 88%;

    --muted: 0 0% 20%;
    --muted-foreground: 42 18% 65%;

    --accent: 42 28% 88%;
    --accent-foreground: 0 0% 12%;

    --destructive: 42 28% 88%;
    --destructive-foreground: 0 0% 12%;

    --border: 0 0% 30%;
    --input: 0 0% 30%;
    --ring: 42 28% 88%;

    --gold-glow: 42 28% 88%;
    --surface-hover: 0 0% 22%;

    --sidebar-background: 0 0% 12%;
    --sidebar-foreground: 42 28% 88%;
    --sidebar-primary: 42 28% 88%;
    --sidebar-primary-foreground: 0 0% 12%;
    --sidebar-accent: 0 0% 20%;
    --sidebar-accent-foreground: 42 28% 88%;
    --sidebar-border: 0 0% 30%;
    --sidebar-ring: 42 28% 88%;
  }
}

@layer base {
  * { @apply border-border; }

  html { background-color: hsl(var(--paper)); }

  body {
    @apply bg-background text-foreground font-body antialiased;
    background-color: hsl(var(--paper));
    background-image:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.07  0 0 0 0 0.05  0 0 0 0 0.03  0 0 0 0.10 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"),
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 31px,
        hsl(0 0% 0% / 0.04) 31px,
        hsl(0 0% 0% / 0.04) 32px
      );
    background-attachment: fixed, fixed;
  }

  h1, h2, h3, h4, h5, h6 { @apply font-heading; }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(circle at 14% 18%, hsl(0 0% 0% / 0.04) 0%, transparent 8%),
      radial-gradient(circle at 86% 72%, hsl(0 0% 0% / 0.03) 0%, transparent 9%),
      radial-gradient(circle at 50% 50%, hsl(0 0% 0% / 0.02) 0%, transparent 10%);
  }
}

@layer utilities {
  /* All typography is typewriter / courier */
  .font-typewriter { font-family: 'Special Elite', 'Courier Prime', monospace; }
  .font-courier    { font-family: 'Courier Prime', 'Cutive Mono', monospace; }
  .font-cutive     { font-family: 'Cutive Mono', 'Courier Prime', monospace; }
  .font-stencil    { font-family: 'Courier Prime', 'Special Elite', monospace; font-weight: 700; letter-spacing: 0.05em; }
  .font-blackops   { font-family: 'Courier Prime', 'Special Elite', monospace; font-weight: 700; letter-spacing: 0.04em; }

  /* All ink is black */
  .text-stamp-red, .text-stamp-blue  { color: hsl(var(--ink-charcoal)); }
  .text-ink        { color: hsl(var(--ink-charcoal)); }
  .text-ink-brown  { color: hsl(var(--ink-brown)); }

  .bg-paper        { background-color: hsl(var(--paper)); }
  .bg-paper-cream  { background-color: hsl(var(--paper-cream)); }
  .bg-paper-beige  { background-color: hsl(var(--paper-beige)); }
  .bg-paper-gray   { background-color: hsl(var(--paper-gray)); }

  .border-ink      { border-color: hsl(var(--ink-charcoal)); }
  .border-stamp    { border-color: hsl(var(--ink-charcoal)); }
  .bg-ink          { background-color: hsl(var(--ink-charcoal)); }
  .bg-stamp-red    { background-color: hsl(var(--ink-charcoal)); }

  /* Paper cards - pure photocopy aesthetic */
  .paper-card {
    background-color: hsl(var(--paper-cream));
    background-image:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.07  0 0 0 0 0.05  0 0 0 0 0.03  0 0 0 0.12 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    border: 1px solid hsl(0 0% 12% / 0.65);
    box-shadow:
      0 1px 0 hsl(0 0% 0% / 0.10),
      0 4px 10px -6px hsl(0 0% 0% / 0.30);
    position: relative;
  }

  .paper-card-cream {
    background-color: hsl(var(--paper));
    background-image:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.07  0 0 0 0 0.05  0 0 0 0 0.03  0 0 0 0.10 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    border: 1px solid hsl(0 0% 12% / 0.60);
    box-shadow:
      0 1px 0 hsl(0 0% 0% / 0.08),
      0 6px 14px -8px hsl(0 0% 0% / 0.30);
  }

  .paper-folder {
    background-color: hsl(38 22% 80%);
    background-image:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.10  0 0 0 0 0.08  0 0 0 0 0.05  0 0 0 0.14 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    background-blend-mode: multiply;
    border: 1px solid hsl(0 0% 12% / 0.70);
    box-shadow:
      0 1px 0 hsl(0 0% 0% / 0.10),
      0 10px 22px -12px hsl(0 0% 0% / 0.40);
  }

  .paper-grain::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='1.4' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.07  0 0 0 0 0.05  0 0 0 0 0.03  0 0 0 0.08 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    opacity: 0.55;
    mix-blend-mode: multiply;
  }

  /* RUBBER STAMP - BLACK INK ONLY */
  .stamp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Courier Prime', monospace;
    font-weight: 700;
    color: hsl(var(--ink-charcoal));
    border: 3px double hsl(var(--ink-charcoal));
    padding: 0.35rem 1rem;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    transform: rotate(-4deg);
    background: transparent;
    text-shadow: 0.5px 0 0 hsl(var(--paper));
    position: relative;
  }
  .stamp::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='1.6' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.95  0 0 0 0 0.93  0 0 0 0 0.89  0 0 0 0.92 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    mix-blend-mode: screen;
    opacity: 0.55;
    pointer-events: none;
  }
  .stamp-blue, .stamp-black {
    color: hsl(var(--ink-charcoal));
    border-color: hsl(var(--ink-charcoal));
  }
  .stamp-straight { transform: rotate(0deg); }

  /* Watermark - black faded */
  .watermark {
    font-family: 'Courier Prime', monospace;
    font-weight: 700;
    color: hsl(0 0% 0% / 0.06);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }
  .watermark-dark { color: hsl(0 0% 0% / 0.05); }

  .redacted {
    background-color: hsl(var(--ink-charcoal));
    color: hsl(var(--ink-charcoal));
    padding: 0 0.35em;
    user-select: none;
  }

  /* Tape - subtle paper tone, no colour */
  .tape {
    position: absolute;
    background: hsl(38 20% 78% / 0.7);
    border: 1px solid hsl(0 0% 0% / 0.18);
    box-shadow: 0 1px 2px hsl(0 0% 0% / 0.15);
  }
  .tape-yellow, .tape-clear { background: hsl(38 20% 78% / 0.65); }

  .paperclip {
    position: absolute;
    width: 14px;
    height: 36px;
    border: 2px solid hsl(0 0% 30%);
    border-radius: 7px;
    background: transparent;
  }

  .border-dashed-ink { border: 1.5px dashed hsl(0 0% 12% / 0.7); }
  .border-dotted-ink { border: 2px dotted hsl(0 0% 12% / 0.6); }

  .photocopy {
    filter: grayscale(100%) contrast(1.35) brightness(0.92);
    mix-blend-mode: multiply;
  }
  .photocopy-strong {
    filter: grayscale(100%) contrast(1.7) brightness(0.82);
    mix-blend-mode: multiply;
  }

  .scanline-overlay::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 3px,
      hsl(0 0% 0% / 0.05) 3px,
      hsl(0 0% 0% / 0.05) 4px
    );
    mix-blend-mode: multiply;
  }

  .halftone {
    background-image: radial-gradient(hsl(var(--ink-charcoal) / 0.55) 1px, transparent 1.5px);
    background-size: 4px 4px;
  }

  .crosshatch-bg {
    background-image:
      repeating-linear-gradient(45deg, hsl(0 0% 0% / 0.08) 0 1px, transparent 1px 6px),
      repeating-linear-gradient(-45deg, hsl(0 0% 0% / 0.06) 0 1px, transparent 1px 8px);
  }

  .tactical-grid {
    background-image:
      linear-gradient(hsl(0 0% 0% / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, hsl(0 0% 0% / 0.12) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .dossier-num {
    font-family: 'Courier Prime', monospace;
    font-weight: 700;
    color: hsl(var(--ink-brown));
    letter-spacing: 0.15em;
    font-size: 0.75rem;
  }

  /* Sticky note - now a plain memo slip, no colour */
  .sticky-note {
    background: hsl(38 22% 82%);
    box-shadow:
      0 1px 0 hsl(0 0% 0% / 0.15),
      0 6px 12px -6px hsl(0 0% 0% / 0.25);
    font-family: 'Special Elite', cursive;
    color: hsl(0 0% 12%);
    padding: 0.75rem 1rem;
    position: relative;
    border: 1px solid hsl(0 0% 0% / 0.25);
  }
  .sticky-pink, .sticky-blue { background: hsl(38 22% 82%); }

  .handwritten {
    font-family: 'Special Elite', cursive;
    color: hsl(var(--ink-charcoal));
    transform: rotate(-1.5deg);
    display: inline-block;
  }
  .handwritten-red {
    font-family: 'Special Elite', cursive;
    color: hsl(var(--ink-charcoal));
  }

  .status-pulse::before {
    content: "";
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-right: 0.5em;
    background: hsl(var(--ink-charcoal));
    border-radius: 50%;
    animation: pulse-classified 1.6s ease-in-out infinite;
    vertical-align: middle;
  }

  /* Animations */
  @keyframes typewriter { from { width: 0; } to { width: 100%; } }
  @keyframes blink-caret { 50% { border-color: transparent; } }
  .typewriter-text {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid hsl(var(--ink-charcoal));
    animation: typewriter 2.6s steps(40, end) 0.3s 1 both, blink-caret 0.85s step-end infinite;
  }

  @keyframes stamp-impact {
    0%   { opacity: 0; transform: rotate(-18deg) scale(2.4); }
    30%  { opacity: 1; }
    60%  { transform: rotate(-4deg) scale(1.05); }
    100% { transform: rotate(-4deg) scale(1); opacity: 1; }
  }
  .animate-stamp { animation: stamp-impact 0.9s cubic-bezier(.2,.7,.2,1) 0.4s both; }
  .animate-stamp-blue { animation: stamp-impact 0.9s cubic-bezier(.2,.7,.2,1) 0.7s both; }

  @keyframes scanner-flicker {
    0%, 100% { opacity: 0.05; }
    45% { opacity: 0.16; } 50% { opacity: 0.04; } 55% { opacity: 0.18; }
  }
  .scanner-flicker { animation: scanner-flicker 3.4s ease-in-out infinite; }

  @keyframes pulse-classified {
    0%, 100% { opacity: 1; } 50% { opacity: 0.25; }
  }
  .animate-pulse-classified { animation: pulse-classified 1.4s ease-in-out infinite; }

  @keyframes scan-down {
    0% { transform: translateY(-100%); } 100% { transform: translateY(120%); }
  }
  .scan-bar {
    position: absolute; left: 0; right: 0; height: 30px; pointer-events: none;
    background: linear-gradient(to bottom, hsl(0 0% 100% / 0) 0%, hsl(0 0% 100% / 0.35) 50%, hsl(0 0% 100% / 0) 100%);
    mix-blend-mode: overlay;
    animation: scan-down 5s ease-in-out infinite;
  }

  @keyframes paper-rise {
    from { opacity: 0; transform: translateY(20px) rotate(var(--rot, 0deg)); }
    to   { opacity: 1; transform: translateY(0) rotate(var(--rot, 0deg)); }
  }
  .paper-rise { animation: paper-rise 0.8s ease-out both; }

  @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  .animate-float { animation: float 6s ease-in-out infinite; }

  @keyframes pulse-gold { 0%,100% { opacity: 0.4; } 50% { opacity: 1; } }
  .animate-pulse-gold { animation: pulse-gold 3s ease-in-out infinite; }

  .text-gradient-gold { color: hsl(var(--ink-charcoal)); }
  .border-gradient-gold { border-color: hsl(var(--ink-charcoal)); }
  .glow-gold {
    box-shadow:
      0 1px 0 hsl(0 0% 0% / 0.10),
      0 8px 18px -10px hsl(0 0% 0% / 0.35);
  }
  .glass-card {
    background-color: hsl(var(--paper-cream));
    background-image:
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.95' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.07  0 0 0 0 0.05  0 0 0 0 0.03  0 0 0 0.10 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    border: 1px solid hsl(0 0% 12% / 0.65);
    box-shadow:
      0 1px 0 hsl(0 0% 0% / 0.10),
      0 8px 18px -10px hsl(0 0% 0% / 0.30);
    backdrop-filter: none;
  }
  .grid-pattern {
    background-image:
      linear-gradient(hsl(0 0% 0% / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, hsl(0 0% 0% / 0.12) 1px, transparent 1px);
    background-size: 50px 50px;
  }

  @keyframes marquee-left { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  @keyframes marquee-right { 0% { transform: translateX(-50%); } 100% { transform: translateX(0); } }
  .animate-marquee-left  { animation: marquee-left 120s linear infinite; }
  .animate-marquee-right { animation: marquee-right 120s linear infinite; }

  .marquee-container:hover .animate-marquee-left,
  .marquee-container:hover .animate-marquee-right {
    animation-play-state: paused;
  }

  .animate-ticker { animation: marquee-left 45s linear infinite; }

  .diag-stripes {
    background-image: repeating-linear-gradient(
      45deg,
      hsl(var(--ink-charcoal)) 0 12px,
      hsl(var(--paper)) 12px 24px
    );
  }
  .diag-stripes-red {
    background-image: repeating-linear-gradient(
      45deg,
      hsl(var(--ink-charcoal)) 0 10px,
      hsl(var(--paper)) 10px 20px
    );
  }

  .barcode {
    background-image: repeating-linear-gradient(
      90deg,
      hsl(var(--ink-charcoal)) 0 1px, transparent 1px 3px,
      hsl(var(--ink-charcoal)) 3px 5px, transparent 5px 6px,
      hsl(var(--ink-charcoal)) 6px 8px, transparent 8px 11px,
      hsl(var(--ink-charcoal)) 11px 12px, transparent 12px 15px,
      hsl(var(--ink-charcoal)) 15px 17px, transparent 17px 20px
    );
  }

  /* =========================================================
   * NEW EFFECTS — Declassified Document Treatment
   * ========================================================= */

  /* --- Custom cursor reticle / magnifier --- */
  .has-spy-cursor,
  .has-spy-cursor * {
    cursor: none !important;
  }
  @media (hover: none) {
    .has-spy-cursor,
    .has-spy-cursor * { cursor: auto !important; }
  }

  /* --- Ink bleed reveal (used on scroll) --- */
  @keyframes ink-bleed {
    0%   { clip-path: inset(0 100% 0 0); filter: blur(4px); opacity: 0; }
    40%  { opacity: 1; filter: blur(1.5px); }
    100% { clip-path: inset(0 0 0 0); filter: blur(0); opacity: 1; }
  }
  .ink-bleed-reveal {
    animation: ink-bleed 1.1s cubic-bezier(.22,.61,.36,1) both;
  }

  /* --- Redaction lift: black bar slides off to reveal --- */
  @keyframes redaction-lift {
    0%   { transform: translateX(0); opacity: 1; }
    60%  { transform: translateX(0); opacity: 1; }
    100% { transform: translateX(110%); opacity: 0; }
  }
  .redacted-reveal {
    position: relative;
    display: inline-block;
  }
  .redacted-reveal::after {
    content: "";
    position: absolute;
    inset: -2px -4px;
    background: hsl(var(--ink-charcoal));
    transform-origin: left center;
    pointer-events: none;
  }
  .redacted-reveal.lift::after {
    animation: redaction-lift 1.2s cubic-bezier(.7,.0,.3,1) 0.2s both;
  }
  .redacted-reveal:hover::after {
    animation: redaction-lift 0.6s cubic-bezier(.7,.0,.3,1) both;
  }

  /* --- Glitch redact (used as ambient effect) --- */
  @keyframes glitch-redact {
    0%, 100% { transform: translateX(0); opacity: 0; }
    20% { opacity: 0.9; transform: translateX(-2px); }
    40% { opacity: 0.5; transform: translateX(3px); }
    60% { opacity: 0.95; transform: translateX(-1px); }
    80% { opacity: 0.4; transform: translateX(2px); }
  }
  .glitch-redact {
    animation: glitch-redact 0.6s ease-in-out;
  }

  /* --- Stamp drop (heavier impact for scroll triggers) --- */
  @keyframes stamp-drop-hard {
    0%   { opacity: 0; transform: rotate(-22deg) scale(3); filter: blur(6px); }
    30%  { opacity: 1; filter: blur(0); }
    55%  { transform: rotate(-3deg) scale(0.92); }
    70%  { transform: rotate(-5deg) scale(1.06); }
    85%  { transform: rotate(-4deg) scale(0.98); }
    100% { transform: rotate(-4deg) scale(1); opacity: 1; }
  }
  .stamp-drop-hard {
    animation: stamp-drop-hard 0.85s cubic-bezier(.2,.7,.2,1) both;
  }

  /* --- Page-turn-in section transition --- */
  @keyframes page-turn-in {
    0%   { opacity: 0; transform: perspective(1400px) rotateX(-22deg) translateY(60px); transform-origin: top center; }
    100% { opacity: 1; transform: perspective(1400px) rotateX(0) translateY(0); }
  }
  .page-turn-in {
    animation: page-turn-in 1s cubic-bezier(.22,.61,.36,1) both;
  }

  /* --- Section divider scan bar (between sections) --- */
  @keyframes divider-scan {
    0%   { transform: scaleX(0); transform-origin: left; }
    50%  { transform: scaleX(1); transform-origin: left; }
    51%  { transform: scaleX(1); transform-origin: right; }
    100% { transform: scaleX(0); transform-origin: right; }
  }
  .divider-scan-bar {
    height: 3px;
    background: hsl(var(--ink-charcoal));
    animation: divider-scan 3s ease-in-out infinite;
  }

  /* --- Dust particle drift --- */
  @keyframes dust-drift {
    0%   { transform: translate3d(0, 100vh, 0) rotate(0); opacity: 0; }
    10%  { opacity: 0.7; }
    90%  { opacity: 0.5; }
    100% { transform: translate3d(var(--dx, 40px), -10vh, 0) rotate(360deg); opacity: 0; }
  }
  .dust-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: hsl(0 0% 10% / 0.65);
    border-radius: 50%;
    animation: dust-drift var(--dur, 18s) linear infinite;
    pointer-events: none;
  }

  /* --- Paper scrap drift (occasional larger floating debris) --- */
  @keyframes paper-scrap-drift {
    0%   { transform: translate3d(-10vw, 100vh, 0) rotate(-15deg); opacity: 0; }
    10%  { opacity: 0.45; }
    90%  { opacity: 0.35; }
    100% { transform: translate3d(110vw, -20vh, 0) rotate(720deg); opacity: 0; }
  }
  .paper-scrap {
    position: absolute;
    pointer-events: none;
    background: hsl(38 22% 82% / 0.85);
    border: 1px solid hsl(0 0% 0% / 0.4);
    box-shadow: 0 2px 6px hsl(0 0% 0% / 0.18);
    animation: paper-scrap-drift var(--dur, 30s) linear infinite;
    font-family: 'Courier Prime', monospace;
    color: hsl(0 0% 0% / 0.55);
    font-size: 9px;
    padding: 6px 8px;
    line-height: 1.05;
    overflow: hidden;
  }

  /* --- Big global scan-line sweep that runs once per minute --- */
  @keyframes global-scan {
    0%   { transform: translateY(-110%); opacity: 0; }
    5%   { opacity: 1; }
    95%  { opacity: 1; }
    100% { transform: translateY(110vh); opacity: 0; }
  }
  .global-scan-bar {
    position: fixed;
    inset: 0 0 auto 0;
    height: 140px;
    background: linear-gradient(
      to bottom,
      hsl(0 0% 0% / 0) 0%,
      hsl(0 0% 0% / 0.05) 35%,
      hsl(0 0% 0% / 0.18) 50%,
      hsl(0 0% 0% / 0.05) 65%,
      hsl(0 0% 0% / 0) 100%
    );
    mix-blend-mode: multiply;
    z-index: 60;
    pointer-events: none;
    animation: global-scan 4.5s cubic-bezier(.42,0,.58,1);
  }
  .global-scan-bar::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 49%,
      hsl(0 0% 100% / 0.55) 50%,
      transparent 51%
    );
    mix-blend-mode: overlay;
  }

  /* --- Magnifier hover ring (used for spy cursor) --- */
  .spy-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: width 0.18s cubic-bezier(.2,.7,.2,1),
                height 0.18s cubic-bezier(.2,.7,.2,1),
                border-color 0.18s ease,
                background 0.18s ease;
    will-change: transform;
  }
  .spy-cursor-ring {
    width: 36px;
    height: 36px;
    border: 2px solid hsl(var(--ink-charcoal));
    border-radius: 50%;
    background: hsl(0 0% 100% / 0.04);
    box-shadow:
      0 0 0 1px hsl(0 0% 100% / 0.4) inset,
      0 0 0 1px hsl(0 0% 0% / 0.4),
      0 4px 12px hsl(0 0% 0% / 0.25);
  }
  .spy-cursor-ring.hot {
    width: 56px;
    height: 56px;
    background: hsl(0 0% 100% / 0.12);
  }
  .spy-cursor-cross {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .spy-cursor-cross::before,
  .spy-cursor-cross::after {
    content: "";
    position: absolute;
    background: hsl(var(--ink-charcoal));
  }
  .spy-cursor-cross::before {
    left: 50%; top: -10px; width: 1.5px; height: 8px;
    transform: translateX(-50%);
  }
  .spy-cursor-cross::after {
    left: 50%; bottom: -10px; width: 1.5px; height: 8px;
    transform: translateX(-50%);
  }
  .spy-cursor-h::before,
  .spy-cursor-h::after {
    content: "";
    position: absolute;
    top: 50%;
    height: 1.5px;
    width: 8px;
    background: hsl(var(--ink-charcoal));
    transform: translateY(-50%);
  }
  .spy-cursor-h::before { left: -10px; }
  .spy-cursor-h::after { right: -10px; }

  .spy-cursor-dot {
    position: fixed;
    top: 0; left: 0;
    width: 4px; height: 4px;
    background: hsl(var(--ink-charcoal));
    border-radius: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 9999;
    will-change: transform;
  }

  .spy-cursor-label {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 10px);
    font-family: 'Courier Prime', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    color: hsl(var(--ink-charcoal));
    background: hsl(var(--paper));
    padding: 2px 6px;
    border: 1px solid hsl(var(--ink-charcoal));
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.18s ease;
    text-transform: uppercase;
  }
  .spy-cursor-ring.hot + .spy-cursor-label,
  .spy-cursor.hot .spy-cursor-label {
    opacity: 1;
  }

  /* --- Ink splatter particle (canvas-free fallback) --- */
  @keyframes ink-splat {
    0%   { transform: translate(-50%, -50%) scale(0.2); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(2.4); opacity: 0; }
  }
  .ink-splat {
    position: fixed;
    width: 22px;
    height: 22px;
    background: radial-gradient(circle at 30% 30%, hsl(var(--ink-charcoal)) 0%, hsl(var(--ink-charcoal)) 35%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 60;
    animation: ink-splat 0.7s ease-out forwards;
    mix-blend-mode: multiply;
    will-change: transform;
  }

  /* --- Declassification progress bar (top of page) --- */
  .declass-meter {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 4px;
    z-index: 70;
    pointer-events: none;
    background: transparent;
  }
  .declass-meter-fill {
    height: 100%;
    background: linear-gradient(
      90deg,
      hsl(var(--ink-charcoal)) 0%,
      hsl(var(--ink-charcoal)) 60%,
      transparent 100%
    );
    transform-origin: left center;
    box-shadow: 0 0 0 1px hsl(var(--ink-charcoal) / 0.25),
                0 1px 0 hsl(0 0% 0% / 0.2);
  }
  .declass-meter-fill::after {
    content: "";
    position: absolute;
    right: 0; top: 0; bottom: 0;
    width: 18px;
    background-image: repeating-linear-gradient(
      90deg,
      hsl(var(--ink-charcoal)) 0 2px,
      transparent 2px 4px
    );
  }

  /* --- Section ink-bleed wipe transition (overlay between sections) --- */
  @keyframes ink-wipe-in {
    0%   { transform: scaleY(0); transform-origin: top; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  /* --- Subject-card spotlight (mouse-reactive paper highlight) --- */
  .spotlight-paper {
    position: relative;
    overflow: hidden;
  }
  .spotlight-paper::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      280px circle at var(--mx, 50%) var(--my, 50%),
      hsl(0 0% 100% / 0.18),
      transparent 60%
    );
    mix-blend-mode: overlay;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .spotlight-paper:hover::before {
    opacity: 1;
  }

  /* --- Card lift + ink shadow on hover --- */
  .card-lift {
    transition: transform 0.4s cubic-bezier(.2,.7,.2,1),
                box-shadow 0.4s cubic-bezier(.2,.7,.2,1);
    will-change: transform;
  }
  .card-lift:hover {
    transform: translateY(-6px) rotat